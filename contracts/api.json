{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/olowolayemogoodness-crypto/soro/main/contracts/api.json",
  "title": "api",
  "description": "FROZEN contract v1. FastAPI HTTP surface (M5, default port 8000). Endpoints: GET /health, GET /packs/{topic_id}, POST /session/token, GET /progress. GET /packs/{topic_id} responds with a lesson-pack document; GET /progress returns the student's activity record for the 'My progress' dashboard and daily streak.",
  "type": "object",
  "required": ["GET /health", "GET /packs/{topic_id}", "POST /session/token", "GET /progress"],
  "additionalProperties": false,
  "properties": {
    "GET /health": {
      "type": "object",
      "required": ["response"],
      "additionalProperties": false,
      "properties": {
        "request": { "type": "object" },
        "response": {
          "type": "object",
          "required": ["ok", "tier"],
          "additionalProperties": false,
          "properties": {
            "ok": { "const": true },
            "tier": { "type": "integer", "minimum": 0, "description": "Offline fallback tier currently served (0 = full stack)." },
            "livekit_mode": { "enum": ["nobus", "cloud"], "description": "Which LiveKit deployment is active." }
          }
        }
      }
    },
    "GET /packs/{topic_id}": {
      "type": "object",
      "required": ["response"],
      "additionalProperties": false,
      "properties": {
        "request": {
          "type": "object",
          "properties": {
            "topic_id": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "response": { "$ref": "lesson-pack.json" }
      }
    },
    "POST /session/token": {
      "type": "object",
      "required": ["request", "response"],
      "additionalProperties": false,
      "properties": {
        "request": {
          "type": "object",
          "required": ["room", "participant", "topic_id"],
          "additionalProperties": false,
          "properties": {
            "room": { "type": "string", "minLength": 1 },
            "participant": { "type": "string", "minLength": 1 },
            "topic_id": { "type": "string", "minLength": 1 }
          }
        },
        "response": {
          "type": "object",
          "required": ["livekit_url", "token", "room", "agent_ready"],
          "additionalProperties": false,
          "properties": {
            "livekit_url": { "type": "string", "minLength": 1, "description": "e.g. 'wss://<host>' or 'ws://<nobus-ip>:7880'." },
            "token": { "type": "string", "minLength": 1, "description": "LiveKit access token (JWT). Never log or commit real tokens." },
            "room": { "type": "string", "minLength": 1 },
            "agent_ready": { "type": "boolean", "description": "True once the voice agent has joined the room." }
          }
        }
      }
    },
    "GET /progress": {
      "type": "object",
      "required": ["response"],
      "additionalProperties": false,
      "properties": {
        "request": {
          "type": "object",
          "properties": {
            "participant": { "type": "string", "minLength": 1, "description": "Optional; defaults to the authenticated student." },
            "days": { "type": "integer", "minimum": 1, "description": "Optional look-back window in days." }
          },
          "additionalProperties": false
        },
        "response": {
          "type": "object",
          "required": ["streak", "activity"],
          "additionalProperties": false,
          "properties": {
            "streak": {
              "type": "object",
              "required": ["current", "longest"],
              "additionalProperties": false,
              "properties": {
                "current": { "type": "integer", "minimum": 0, "description": "Consecutive days with at least one learning step or check; a missed day resets to 0." },
                "longest": { "type": "integer", "minimum": 0 }
              }
            },
            "activity": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["date", "subject", "topic_id", "checks"],
                "additionalProperties": false,
                "properties": {
                  "date": { "type": "string", "format": "date", "description": "Day of activity, YYYY-MM-DD." },
                  "subject": { "type": "string", "minLength": 1 },
                  "topic_id": { "type": "string", "minLength": 1 },
                  "topic": { "type": "string", "description": "Optional human-readable topic name." },
                  "steps_completed": { "type": "integer", "minimum": 0 },
                  "checks": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["check_id", "result"],
                      "additionalProperties": false,
                      "properties": {
                        "check_id": { "type": "string", "minLength": 1 },
                        "result": { "enum": ["pass", "partial", "fail"] },
                        "assist": { "type": "boolean" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
