# Sọ̀rọ̀ (Soro) — Environment Template (.env.example)
# Copy to .env (or agent/.env and infra/.env) and fill in real values locally.
# PUBLIC REPO WARNING (https://github.com/MI-TECHDLIN/soro):
# NEVER commit a real .env file or paste real keys into code, issues, or PRs.
# NEVER set ANTHROPIC_API_KEY in your shell environment (keep Claude Code on Claude Pro).

# --- Speech-to-Text (D4: Groq Whisper) ---
GROQ_API_KEY=your_groq_api_key_here
SORO_STT_MODEL=whisper-large-v3-turbo
SORO_STT_LANGUAGE=yo

# --- Tutor Brain (D5: Gemini Flash primary, Groq fallback) ---
SORO_BRAIN_PROVIDER=gemini
SORO_BRAIN_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback: Groq open model (reuses GROQ_API_KEY above)
SORO_BRAIN_FALLBACK_PROVIDER=groq
SORO_BRAIN_FALLBACK_MODEL=llama-3.3-70b-versatile

# --- Voice Output / TTS (D3: Spitch TTS + pre-recorded glossary audio) ---
SPITCH_API_KEY=your_spitch_api_key_here
SORO_TTS_MODE=spitch_with_cache
SORO_AUDIO_CACHE_DIR=content/audio/cache

# --- Real-Time Media Server (D7: Nobus self-host primary, LiveKit Cloud failover) ---
# Switch LIVEKIT_MODE between "nobus" and "cloud" for instant failover:
LIVEKIT_MODE=nobus
SORO_DUPLEX_MODE=full_duplex

# Primary: Self-hosted LiveKit SFU on Nobus Cloud (Lagos)
NOBUS_LIVEKIT_URL=ws://your_nobus_public_ip:7880
NOBUS_LIVEKIT_API_KEY=your_nobus_livekit_key_here
NOBUS_LIVEKIT_API_SECRET=your_nobus_livekit_secret_here

# Failover: LiveKit Cloud (free Build tier)
CLOUD_LIVEKIT_URL=wss://your_project.livekit.cloud
CLOUD_LIVEKIT_API_KEY=your_cloud_livekit_key_here
CLOUD_LIVEKIT_API_SECRET=your_cloud_livekit_secret_here

# --- FastAPI & Postgres (M5 Server) ---
SORO_API_HOST=0.0.0.0
SORO_API_PORT=8000
DATABASE_URL=postgresql+asyncpg://soro:soro_local_dev@localhost:5432/soro
