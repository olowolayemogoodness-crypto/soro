# Copy to infra/.env on the server and fill in. NEVER commit the real file (public repo).

# "nobus" = self-hosted LiveKit, "cloud" = LiveKit Cloud failover. Restart api after changing.
LIVEKIT_MODE=nobus

# Self-hosted LiveKit on the Nobus VM. Use the VM's public IP or domain.
NOBUS_LIVEKIT_URL=ws://<nobus-public-ip>:7880
NOBUS_LIVEKIT_API_KEY=<choose-a-key-name>
NOBUS_LIVEKIT_API_SECRET=<random-string-of-32-plus-chars>

# LiveKit Cloud failover (free Build tier)
CLOUD_LIVEKIT_URL=wss://<project>.livekit.cloud
CLOUD_LIVEKIT_API_KEY=<cloud-key>
CLOUD_LIVEKIT_API_SECRET=<cloud-secret>

POSTGRES_PASSWORD=<random-password>
# PGDATA_DIR=/mnt/fbs/pgdata   # set once the Nobus block volume is mounted

SORO_TIER=0
SORO_AGENT_READY=false
SORO_CORS_ORIGINS=*
