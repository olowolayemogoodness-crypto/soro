{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku",
    "CLAUDE_CODE_SUBAGENT_MODEL_FORCE": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit(/agent/**)",
      "Edit(/content/**)",
      "Edit(/infra/**)",
      "Edit(/docs/**)",
      "Edit(/.claude/**)",
      "Edit(/.github/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/SETUP-FOR-GOODNESS.md)",
      "Edit(/README.md)",
      "Edit(/.gitignore)",
      "Edit(/.env.example)",
      "Edit(/agent/.env.example)",
      "Edit(/infra/.env.example)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git worktree*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git merge*)",
      "Bash(git push -u origin fr/*)",
      "Bash(git push origin fr/*)",
      "Bash(git bundle*)",
      "Bash(gh issue*)",
      "Bash(gh pr*)",
      "Bash(gh label*)",
      "Bash(gh repo view*)",
      "Bash(gh auth status*)",
      "Bash(uv *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(lk *)",
      "Bash(livekit-cli *)",
      "Bash(curl *)",
      "Bash(ffmpeg *)",
      "Bash(ffprobe *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(uname *)",
      "Bash(date *)"
    ],
    "ask": [
      "Edit(/app/**)",
      "Edit(/contracts/**)",
      "Bash(git push --force*)",
      "Bash(git push origin main*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./agent/.env)",
      "Read(./infra/.env)",
      "Read(./secrets/**)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.production)",
      "Edit(./agent/.env)",
      "Edit(./infra/.env)",
      "Edit(./secrets/**)"
    ]
  }
}
