  "problems": [
    {
      "id": "p1",
      "statement_yo": "Yànjú quadratic equation x² − 5x + 6 = 0",
      "statement_en": "Solve x² − 5x + 6 = 0",
      "equation": "x² − 5x + 6 = 0",
      "steps": [
        {
          "id": "s1",
          "prompt_yo": "Wo quadratic equation tó wà lórí screen yìí; kí ni iye coefficient a, b, àti constant c tí o rí níbẹ̀?",
          "prompt_en": "What are the values of coefficient a, b, and constant c?",
          "acceptable_concepts": [
            "a=1",
            "b=-5",
            "c=6"
          ],
          "misconceptions": {
            "b=5": "Dúró náà, wo àmì tó wà níwájú 5x: ṣé plus five ni tàbí minus five?",
            "c=-6": "Wo àmì tó wà níwájú 6 ní òpin equation náà: ṣé plus ni tàbí minus?"
          },
          "hint_ladder": [
            "Wo nọ́mbà tó dúró níwájú x², x, àti nọ́mbà tó dá dúró.",
            "Ìtọ́ka: ax² + bx + c = 0, kí ni nọ́mbà tó wà níwájú x?"
          ],
          "canvas_ops": [
            {
              "op": "write_step",
              "params": {
                "step_id": "s1",
                "latex_or_text": "a = ?, b = ?, c = ?",
                "author": "tutor",
                "reveal_answer": false
              }
            }
          ],
          "term_ids": [
            "coefficient",
            "constant"
          ]
        },
        {
          "id": "s2",
          "prompt_yo": "Nọ́mbà méjì wo ni ìsọdipúpọ̀ wọn jẹ́ c, tí àròpọ̀ wọn sì jẹ́ b?",
          "prompt_en": "Which two numbers multiply to give c and add up to b?",
          "acceptable_concepts": [
            "pair=-2,-3",
            "pair=-3,-2"
          ],
          "misconceptions": {
            "pair=2,3": "Wo àmì b lẹ́ẹ̀kan sí i: àròpọ̀ 2 àti 3 jẹ́ 5, ṣé ó bá b mu?",
            "pair=1,6": "Ìsọdipúpọ̀ 1 àti 6 jẹ́ 6, ṣùgbọ́n kí ni àròpọ̀ wọn, ṣé ó bá b mu?"
          },
          "hint_ladder": [
            "Kọ àwọn nọ́mbà méjì tí ìsọdipúpọ̀ wọn jẹ́ 6 sílẹ̀ kí o wo àròpọ̀ olúkúlùkù wọn.",
            "Àwọn nọ́mbà méjèèjì ní àmì kan náà nítorí c jẹ́ positive."
          ],
          "canvas_ops": [
            {
              "op": "write_step",
              "params": {
                "step_id": "s2",
                "latex_or_text": "? × ? = c,  ? + ? = b",
                "author": "tutor",
                "reveal_answer": false
              }
            }
          ],
          "term_ids": [
            "product",
            "sum"
          ]
        },
        {
          "id": "s3",
          "prompt_yo": "Fi àwọn nọ́mbà méjì náà sí àwọn ibi tí ó ṣófo nínú brackets méjèèjì; kí ni o máa kọ sí bracket àkọ́kọ́?",
          "prompt_en": "Fill the blanks in the two brackets with your numbers; what goes in the first bracket?",
          "acceptable_concepts": [
            "factored=(x-2)(x-3)"
          ],
          "misconceptions": {
            "factored=(x+2)(x+3)": "Tí o bá expand (x + 2)(x + 3), ṣé middle term máa fún wa −5x tàbí +5x?",
            "factored=(x-1)(x-6)": "Tí o bá expand (x − 1)(x − 6), ṣé middle term máa fún wa −5x?"
          },
          "hint_ladder": [
            "Expand brackets rẹ padà kí o wo middle term.",
            "Ṣé middle term tí o rí bá b mu?"
          ],
          "canvas_ops": [
            {
              "op": "write_step",
              "params": {
                "step_id": "s3",
                "latex_or_text": "(x - ?)(x - ?) = 0",
                "author": "tutor",
                "reveal_answer": false
              }
            }
          ],
          "term_ids": [
            "factorise",
            "brackets",
            "expand"
          ]
        },
        {
          "id": "s4",
          "prompt_yo": "Tí ìsọdipúpọ̀ bá jẹ́ zero, kí ni ó gbọ́dọ̀ jẹ́ òótọ́ nípa ọ̀kan nínú brackets náà?",
          "prompt_en": "If a product equals zero, what must be true about one of the brackets?",
          "acceptable_concepts": [
            "one bracket = 0"
          ],
          "misconceptions": {
            "both brackets must equal 1": "Tí ìsọdipúpọ̀ bá jẹ́ 1, kìí ṣe zero; kí ni nọ́mbà méjì tí ìsọdipúpọ̀ wọn jẹ́ zero?"
          },
          "hint_ladder": [
            "Ronú nípa 0 × 5 àti 7 × 0; kí ni ó wà ní ìbámu láàrin wọn?"
          ],
          "canvas_ops": [
            {
              "op": "write_step",
              "params": {
                "step_id": "s4",
                "latex_or_text": "x - ? = 0  or  x - ? = 0",
                "author": "tutor",
                "reveal_answer": false
              }
            }
          ],
          "term_ids": [
            "zero_product"
          ]
        },
        {
          "id": "s5",
          "prompt_yo": "Wo parabola náà: níbo ni ó ti kan x-axis, ṣé ó bá àwọn gbòǹgbò rẹ mu?",
          "prompt_en": "Look at the parabola: where does it cross the x-axis, and does that match your roots?",
          "acceptable_concepts": [
            "crossings match roots"
          ],
          "misconceptions": {},
          "hint_ladder": [
            "Wo ibi tí ìlà náà ti kan x-axis lórí graph."
